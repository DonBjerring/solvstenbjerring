---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listPublicImages } from '../lib/gallery';

const images = listPublicImages('trivan');
const background = images[0];
---

<BaseLayout title="Trivan" description="Trivan">
  <section
    class="relative min-h-[70vh] flex items-end md:items-center"
    style={background ? `background-image: url('${background.src}'); background-size: cover; background-position: center;` : undefined}
  >
    {
      !background && (
        <div class="absolute inset-0 bg-gradient-to-b from-mist to-sand" aria-hidden="true" />
      )
    }
    {
      background && (
        <div class="absolute inset-0 bg-deep/35" aria-hidden="true" />
      )
    }
    <div class="relative mx-auto max-w-3xl px-4 py-16 w-full">
      <h1 class:list={['text-4xl md:text-5xl', background ? 'text-foam' : 'text-deep']}>
        Trivan
      </h1>
      <p class:list={['mt-6 text-lg leading-relaxed max-w-xl', background ? 'text-foam/90' : 'text-sea']}>
        Trine og Ivan fandt sammen den 7. maj 2010. Det er alt du behøver at vide for nu.
      </p>
    </div>
  </section>
</BaseLayout>
