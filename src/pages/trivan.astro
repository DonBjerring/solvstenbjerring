---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageWithSkeleton from '../components/ImageWithSkeleton.astro';
import { listPublicImages } from '../lib/gallery';

const images = listPublicImages('trivan');
const photo = images[0];
---

<BaseLayout title="Trivan" description="Trivan">
  {
    photo ? (
      <section class="w-full lg:mx-auto lg:max-w-5xl lg:px-4">
        <div class="relative overflow-hidden">
          <ImageWithSkeleton src={photo.src} imgClass="block" loading="eager" />
          <div class="absolute inset-0 z-10 bg-gradient-to-b from-deep/50 via-deep/15 to-transparent" aria-hidden="true" />
          <div class="absolute inset-x-0 top-0 z-10 px-5 pt-8 sm:px-6 lg:px-4 lg:pt-12">
            <div class="lg:mx-auto lg:max-w-3xl">
              <h1 class="text-4xl md:text-5xl text-foam">Trivan</h1>
              <p class="mt-4 text-lg text-foam/90 leading-relaxed">
                Trine og Ivan fandt sammen den 7. maj 2010. Det er alt, du behøver at vide for nu.
              </p>
            </div>
          </div>
        </div>
      </section>
    ) : (
      <section class="mx-auto max-w-3xl px-4 py-12">
        <h1 class="text-4xl text-deep">Trivan</h1>
        <p class="mt-6 text-lg text-sea leading-relaxed">
          Trine og Ivan fandt sammen den 7. maj 2010. Det er alt, du behøver at vide for nu.
        </p>
      </section>
    )
  }
</BaseLayout>
