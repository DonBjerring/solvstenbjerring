---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';
---

<BaseLayout title="Markus" description="Opdateringer, billeder og diplomer om Markus.">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-4xl text-deep">Markus</h1>
    <p class="mt-4 text-lg text-sea leading-relaxed">
      Her samler vi Markus’ forløb, billeder og diplomer — men kun de ting vi selv synes vi vil dele, styr din nysgerrighed!
    </p>
    <ul class="mt-10 space-y-4 list-none p-0">
      <li>
        <a href={withBase('/markus/story/')} class="text-2xl font-display text-deep hover:text-sea transition-colors">
          Forløb
        </a>
        <p class="mt-1 text-sea">Markus' forløb indtil videre i hovedtræk.</p>
      </li>
      <li>
        <a href={withBase('/markus/gallery/')} class="text-2xl font-display text-deep hover:text-sea transition-colors">
          Galleri
        </a>
        <p class="mt-1 text-sea">Billeder af Markus.</p>
      </li>
      <li>
        <a href={withBase('/markus/diplomas/')} class="text-2xl font-display text-deep hover:text-sea transition-colors">
          Diplomer
        </a>
        <p class="mt-1 text-sea">Diplomer, som den seje dreng har samlet til sig gennem forløbet.</p>
      </li>
    </ul>
  </div>
</BaseLayout>
