---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import { listPublicImages } from '../../lib/gallery';

const images = listPublicImages('markus/diplomas');
---

<BaseLayout title="Diplomer" description="Diplomer og certifikater.">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-4xl text-deep">Diplomer</h1>
    <p class="mt-3 text-sea">Diplomer, som den seje dreng har samlet til sig gennem forløbet.</p>
    <div class="mt-8">
      <GalleryGrid images={images} emptyMessage="Ingen diplomer endnu." lightbox />
    </div>
  </div>
</BaseLayout>
