---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UpdateCard from '../../../components/UpdateCard.astro';
import { withBase } from '../../../lib/urls';
import { resolveStoryDate } from '../../../lib/story';

const posts = (await getCollection('story'))
  .map((post) => {
    const date =
      resolveStoryDate({ date: post.data.date, image: post.data.image }) ??
      new Date(0);
    const title = post.data.title?.trim() || undefined;
    const summary = post.data.summary ?? post.data.text ?? '';
    return { post, date, title, summary };
  })
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<BaseLayout title="Indlæggelsesforløb" description="Opdateringer om Markus’ indlæggelsesforløb.">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-4xl text-deep">Indlæggelsesforløb</h1>
    <p class="mt-3 text-sea">Markus' indlæggelsesforløb i hovedtræk.</p>
    {
      posts.length === 0 ? (
        <p class="mt-10 text-sea text-lg">Ingen opdateringer endnu.</p>
      ) : (
        <div class="mt-8">
          {posts.map(({ post, date, title, summary }) => (
            <UpdateCard
              title={title}
              date={date}
              summary={summary}
              href={withBase(`/markus/story/${post.id}/`)}
              hasImage={Boolean(post.data.image?.trim())}
            />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
