---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StoryPost from '../../../components/StoryPost.astro';
import { withBase } from '../../../lib/urls';
import {
  formatStoryTitle,
  resolveStoryDate,
} from '../../../lib/story';

export async function getStaticPaths() {
  const posts = await getCollection('story');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const date = resolveStoryDate({ date: post.data.date, image: post.data.image }) ?? undefined;
const heading = post.data.title?.trim() || null;
const pageTitle = heading ?? (date ? formatStoryTitle(date) : 'Indlæg');
const description = post.data.summary ?? post.data.text ?? pageTitle;
const hasMarkdownBody = Boolean(post.body?.trim());
---

<BaseLayout title={pageTitle} description={description}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-sm text-sea">
      <a href={withBase('/markus/story/')} class="hover:underline">← Indlæggelsesforløb</a>
    </p>
    <div class="mt-6">
      <StoryPost
        image={post.data.image}
        text={post.data.text}
        title={post.data.title}
        date={date}
      />
    </div>
    {
      hasMarkdownBody && (
        <div class="prose prose-lg mt-8 max-w-none text-deep/90 leading-relaxed">
          <Content />
        </div>
      )
    }
  </div>
</BaseLayout>
