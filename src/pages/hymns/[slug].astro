---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';

export async function getStaticPaths() {
  const hymns = await getCollection('hymns');

  function byTitleDa(
    a: (typeof hymns)[number],
    b: (typeof hymns)[number],
  ) {
    return a.data.title.localeCompare(b.data.title, 'da');
  }

  const ordered = [
    ...hymns.filter((h) => h.data.section === 'songs').sort(byTitleDa),
    ...hymns.filter((h) => h.data.section === 'lullabies').sort(byTitleDa),
  ];

  return ordered.map((hymn, index) => ({
    params: { slug: hymn.id },
    props: {
      hymn,
      prev: index > 0 ? ordered[index - 1] : null,
      next: index < ordered.length - 1 ? ordered[index + 1] : null,
    },
  }));
}

const { hymn, prev, next } = Astro.props;
const lyrics = hymn.body?.trim() ?? '';
---

<BaseLayout title={hymn.data.title} description={hymn.data.note ?? hymn.data.title}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <div class="flex items-start justify-between gap-4">
      <p class="text-sm text-sea min-w-0">
        <a href={withBase('/hymns/')} class="hover:underline">← Sanghæfte</a>
      </p>
      <div class="shrink-0 text-right">
        <label
          class="inline-flex items-center gap-2 text-deep cursor-pointer select-none"
          data-singing-label
        >
          <input
            type="checkbox"
            class="size-5 accent-sea"
            data-singing-toggle
          />
          <span class="text-sm">Jeg synger</span>
        </label>
      </div>
    </div>

    <article class="mt-6">
      <h1 class="text-4xl text-deep">{hymn.data.title}</h1>
      {
        hymn.data.note && (
          <p class="mt-3 text-sea/90 italic">{hymn.data.note}</p>
        )
      }
      {
        (hymn.data.melody || hymn.data.lyrics) && (
          <p class:list={[hymn.data.note ? 'mt-2' : 'mt-3', 'text-sm text-sea leading-relaxed']}>
            {hymn.data.melody && <>Melodi: {hymn.data.melody}</>}
            {hymn.data.melody && hymn.data.lyrics && <span aria-hidden="true"> · </span>}
            {hymn.data.lyrics && <>Tekst: {hymn.data.lyrics}</>}
          </p>
        )
      }

      {
        lyrics && (
          <div class="mt-8 text-lg text-deep/90 leading-relaxed whitespace-pre-line">
            {lyrics}
          </div>
        )
      }
    </article>

    {
      (prev || next) && (
        <nav
          class="mt-12 flex items-start justify-between gap-6 border-t border-mist pt-8"
          aria-label="Sangnavigation"
        >
          {prev ? (
            <a
              href={withBase(`/hymns/${prev.id}/`)}
              class="group max-w-[45%] text-left transition-colors"
            >
              <span class="block text-sm text-sea group-hover:text-deep">← Forrige</span>
              <span class="mt-1 block text-deep group-hover:text-sea leading-snug">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a
              href={withBase(`/hymns/${next.id}/`)}
              class="group ml-auto max-w-[45%] text-right transition-colors"
            >
              <span class="block text-sm text-sea group-hover:text-deep">Næste →</span>
              <span class="mt-1 block text-deep group-hover:text-sea leading-snug">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </div>

  <div
    class="fixed inset-x-0 bottom-0 z-50 border-t border-mist bg-sand/95 backdrop-blur-sm px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]"
    data-singing-controls
    hidden
  >
    <div class="mx-auto max-w-3xl flex flex-col items-center gap-2 sm:flex-row sm:justify-between sm:items-center">
      <p class="text-xs text-sea order-2 sm:order-1" data-singing-hint>
        Skærmen holdes tændt
      </p>
      <div class="flex items-center gap-2 order-1 sm:order-2">
        <span class="text-xs text-sea">Scroll</span>
        <div class="inline-flex rounded-sm border border-mist overflow-hidden bg-foam" role="group" aria-label="Scrollhastighed">
          <button
            type="button"
            class="px-3 py-2 text-sm text-sea hover:bg-mist/50 data-[active=true]:bg-mist data-[active=true]:text-deep"
            data-scroll-speed="none"
            data-active="true"
          >
            Ingen
          </button>
          <button
            type="button"
            class="px-3 py-2 text-sm text-sea border-l border-mist hover:bg-mist/50 data-[active=true]:bg-mist data-[active=true]:text-deep"
            data-scroll-speed="slow"
          >
            Langsom
          </button>
          <button
            type="button"
            class="px-3 py-2 text-sm text-sea border-l border-mist hover:bg-mist/50 data-[active=true]:bg-mist data-[active=true]:text-deep"
            data-scroll-speed="medium"
          >
            Middel
          </button>
          <button
            type="button"
            class="px-3 py-2 text-sm text-sea border-l border-mist hover:bg-mist/50 data-[active=true]:bg-mist data-[active=true]:text-deep"
            data-scroll-speed="fast"
          >
            Hurtig
          </button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const toggle = document.querySelector('[data-singing-toggle]');
  const controls = document.querySelector('[data-singing-controls]');
  const hint = document.querySelector('[data-singing-hint]');
  const speedButtons = document.querySelectorAll('[data-scroll-speed]');
  const wakeLockSupported = 'wakeLock' in navigator;

  /** Pixels per second. Slow matches the previous smooth pace; medium/fast stay farther apart for mobile. */
  const SPEEDS = {
    none: 0,
    slow: 12,
    medium: 25,
    fast: 45,
  };

  if (toggle instanceof HTMLInputElement && controls instanceof HTMLElement) {
    let wakeLock = null;
    let speed = 'none';
    let scrolling = false;
    let rafId = 0;
    let lastTs = 0;
    /** Fractional scroll position — browsers round scrollTop to integers */
    let scrollPos = 0;

    function setHint(text) {
      if (hint instanceof HTMLElement) hint.textContent = text;
    }

    function updateHint() {
      if (speed === 'none') {
        setHint('Skærmen holdes tændt');
      } else if (scrolling) {
        setHint('Autoscroll kører · vælger Ingen hvis du selv scroller');
      } else {
        setHint('Vælg hastighed for at starte autoscroll');
      }
    }

    function setControlsVisible(visible) {
      controls.hidden = !visible;
      document.body.classList.toggle('singing-mode', visible);
    }

    function setActiveSpeed(next) {
      speed = next;
      speedButtons.forEach((btn) => {
        if (!(btn instanceof HTMLElement)) return;
        btn.dataset.active = String(btn.dataset.scrollSpeed === speed);
      });
    }

    async function requestWakeLock() {
      if (!wakeLockSupported) return;
      try {
        wakeLock = await navigator.wakeLock.request('screen');
        wakeLock.addEventListener('release', () => {
          wakeLock = null;
        });
      } catch {
        // optional
      }
    }

    async function releaseWakeLock() {
      if (!wakeLock) return;
      try {
        await wakeLock.release();
      } catch {
        // ignore
      }
      wakeLock = null;
    }

    function maxScrollTop() {
      const el = document.scrollingElement || document.documentElement;
      return Math.max(0, el.scrollHeight - window.innerHeight);
    }

    function currentScrollTop() {
      const el = document.scrollingElement || document.documentElement;
      return el.scrollTop;
    }

    function tick(ts) {
      if (!scrolling) return;
      const pxPerSec = SPEEDS[speed] ?? 0;
      if (pxPerSec <= 0) {
        stopScroll();
        return;
      }

      if (!lastTs) lastTs = ts;
      const delta = Math.min((ts - lastTs) / 1000, 0.1);
      lastTs = ts;

      const max = maxScrollTop();
      scrollPos = Math.min(scrollPos + pxPerSec * delta, max);
      window.scrollTo(0, scrollPos);

      if (scrollPos >= max - 0.5) {
        stopScroll();
        setHint('Slut på siden');
        return;
      }

      rafId = requestAnimationFrame(tick);
    }

    function startScroll() {
      if (SPEEDS[speed] <= 0) {
        stopScroll();
        updateHint();
        return;
      }
      scrollPos = currentScrollTop();
      if (scrollPos >= maxScrollTop() - 0.5) {
        setHint('Slut på siden');
        return;
      }
      if (scrolling) {
        updateHint();
        return;
      }
      scrolling = true;
      lastTs = 0;
      updateHint();
      rafId = requestAnimationFrame(tick);
    }

    function stopScroll() {
      scrolling = false;
      lastTs = 0;
      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;
    }

    function pauseScrollFromUser() {
      if (!scrolling) return;
      stopScroll();
      scrollPos = currentScrollTop();
      setActiveSpeed('none');
      updateHint();
    }

    function applySpeed(next) {
      setActiveSpeed(next);
      if (!toggle.checked) return;
      if (next === 'none') {
        stopScroll();
        updateHint();
      } else {
        startScroll();
      }
    }

    function startSinging() {
      setControlsVisible(true);
      setActiveSpeed(speed);
      requestWakeLock();
      if (speed === 'none') {
        stopScroll();
        updateHint();
      } else {
        startScroll();
      }
    }

    function stopSinging() {
      stopScroll();
      releaseWakeLock();
      setControlsVisible(false);
      setHint('Skærmen holdes tændt');
    }

    toggle.addEventListener('change', () => {
      if (toggle.checked) startSinging();
      else stopSinging();
    });

    speedButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!(btn instanceof HTMLElement)) return;
        const next = btn.dataset.scrollSpeed;
        if (!next || !(next in SPEEDS)) return;
        applySpeed(next);
      });
    });

    // Pause on user scroll, but not when interacting with the bottom controls
    window.addEventListener(
      'wheel',
      (event) => {
        if (event.target instanceof Node && controls.contains(event.target)) return;
        pauseScrollFromUser();
      },
      { passive: true },
    );
    window.addEventListener(
      'touchmove',
      (event) => {
        if (event.target instanceof Node && controls.contains(event.target)) return;
        pauseScrollFromUser();
      },
      { passive: true },
    );
    window.addEventListener('keydown', (event) => {
      const keys = ['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' '];
      if (keys.includes(event.key)) pauseScrollFromUser();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && toggle.checked) {
        requestWakeLock();
      } else if (document.visibilityState === 'hidden') {
        stopScroll();
      }
    });
  }
</script>

<style is:global>
  body.singing-mode {
    padding-bottom: 5.5rem;
  }
</style>
