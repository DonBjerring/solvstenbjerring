---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';

export async function getStaticPaths() {
  const hymns = await getCollection('hymns');

  function byTitleDa(
    a: (typeof hymns)[number],
    b: (typeof hymns)[number],
  ) {
    return a.data.title.localeCompare(b.data.title, 'da');
  }

  const ordered = [
    ...hymns.filter((h) => h.data.section === 'songs').sort(byTitleDa),
    ...hymns.filter((h) => h.data.section === 'lullabies').sort(byTitleDa),
  ];

  return ordered.map((hymn, index) => ({
    params: { slug: hymn.id },
    props: {
      hymn,
      prev: index > 0 ? ordered[index - 1] : null,
      next: index < ordered.length - 1 ? ordered[index + 1] : null,
    },
  }));
}

const { hymn, prev, next } = Astro.props;
const lyrics = hymn.body?.trim() ?? '';
---

<BaseLayout title={hymn.data.title} description={hymn.data.note ?? hymn.data.title}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-sm text-sea">
      <a href={withBase('/hymns/')} class="hover:underline">← Sanghæfte</a>
    </p>

    <article class="mt-6">
      <div class="flex items-start justify-between gap-4">
        <h1 class="text-4xl text-deep min-w-0">{hymn.data.title}</h1>
        <div class="shrink-0 text-right pt-1">
          <label
            class="inline-flex items-center gap-2 text-deep cursor-pointer select-none"
            data-singing-label
          >
            <input
              type="checkbox"
              class="size-5 accent-sea"
              data-singing-toggle
            />
            <span class="text-sm sm:text-base">Jeg synger</span>
          </label>
          <p class="mt-1 text-xs text-sea max-w-[9rem] ml-auto" data-singing-hint hidden>
            Skærmen holdes tændt
          </p>
        </div>
      </div>
      {
        hymn.data.note && (
          <p class="mt-3 text-sea/90 italic">{hymn.data.note}</p>
        )
      }
      {
        (hymn.data.melody || hymn.data.lyrics) && (
          <p class:list={[hymn.data.note ? 'mt-2' : 'mt-3', 'text-sm text-sea leading-relaxed']}>
            {hymn.data.melody && <>Melodi: {hymn.data.melody}</>}
            {hymn.data.melody && hymn.data.lyrics && <span aria-hidden="true"> · </span>}
            {hymn.data.lyrics && <>Tekst: {hymn.data.lyrics}</>}
          </p>
        )
      }

      {
        lyrics && (
          <div class="mt-8 text-lg text-deep/90 leading-relaxed whitespace-pre-line">
            {lyrics}
          </div>
        )
      }
    </article>

    {
      (prev || next) && (
        <nav
          class="mt-12 flex items-start justify-between gap-6 border-t border-mist pt-8"
          aria-label="Sangnavigation"
        >
          {prev ? (
            <a
              href={withBase(`/hymns/${prev.id}/`)}
              class="group max-w-[45%] text-left transition-colors"
            >
              <span class="block text-sm text-sea group-hover:text-deep">← Forrige</span>
              <span class="mt-1 block text-deep group-hover:text-sea leading-snug">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a
              href={withBase(`/hymns/${next.id}/`)}
              class="group ml-auto max-w-[45%] text-right transition-colors"
            >
              <span class="block text-sm text-sea group-hover:text-deep">Næste →</span>
              <span class="mt-1 block text-deep group-hover:text-sea leading-snug">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </div>
</BaseLayout>

<script>
  const toggle = document.querySelector('[data-singing-toggle]');
  const hint = document.querySelector('[data-singing-hint]');
  const wakeLockSupported = 'wakeLock' in navigator;

  if (toggle instanceof HTMLInputElement) {
    let wakeLock = null;

    async function requestWakeLock() {
      if (!wakeLockSupported) return;
      try {
        wakeLock = await navigator.wakeLock.request('screen');
        wakeLock.addEventListener('release', () => {
          wakeLock = null;
        });
        if (hint instanceof HTMLElement) hint.hidden = false;
      } catch {
        toggle.checked = false;
        if (hint instanceof HTMLElement) hint.hidden = true;
      }
    }

    async function releaseWakeLock() {
      if (wakeLock) {
        try {
          await wakeLock.release();
        } catch {
          // ignore
        }
        wakeLock = null;
      }
      if (hint instanceof HTMLElement) hint.hidden = true;
    }

    toggle.addEventListener('change', () => {
      if (toggle.checked) {
        requestWakeLock();
      } else {
        releaseWakeLock();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && toggle.checked) {
        requestWakeLock();
      }
    });

    if (!wakeLockSupported) {
      toggle.disabled = true;
      const label = document.querySelector('[data-singing-label]');
      if (label instanceof HTMLElement) {
        label.title = 'Ikke understøttet i denne browser';
        label.classList.add('opacity-50');
      }
    }
  }
</script>
