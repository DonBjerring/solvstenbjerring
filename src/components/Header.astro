---
import { withBase } from '../lib/urls';

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

function isActive(href: string): boolean {
  const full = withBase(href);
  if (href === '/') {
    return pathname === base || pathname === `${base.replace(/\/$/, '')}` || pathname === '/';
  }
  return pathname === full || pathname.startsWith(full);
}

const markusActive = isActive('/markus/');
---

<header class="border-b border-mist bg-sand/95 backdrop-blur-sm sticky top-0 z-40">
  <div class="mx-auto max-w-5xl px-4 py-4 flex items-center justify-between gap-4">
    <a href={withBase('/')} class="font-display text-xl text-deep hover:text-sea transition-colors">
      Sølvsten Bjerring
    </a>

    <button
      type="button"
      id="nav-toggle"
      class="md:hidden inline-flex items-center justify-center rounded-sm border border-mist px-3 py-2 text-sm text-deep"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      Menu
    </button>

    <nav
      id="site-nav"
      class="hidden md:block absolute md:static left-0 right-0 top-full bg-sand md:bg-transparent border-b border-mist md:border-0 px-4 pb-4 md:p-0 z-50"
      aria-label="Hovedmenu"
    >
      <ul class="flex flex-col md:flex-row md:items-center gap-1 md:gap-6 text-base pt-2 md:pt-0">
        <li>
          <a
            href={withBase('/')}
            class:list={[
              'block py-2 md:py-0 transition-colors',
              isActive('/') && !markusActive ? 'text-deep font-medium' : 'text-sea hover:text-deep',
            ]}
          >
            Forside
          </a>
        </li>
        <li>
          <a
            href={withBase('/trivan/')}
            class:list={[
              'block py-2 md:py-0 transition-colors',
              isActive('/trivan/') ? 'text-deep font-medium' : 'text-sea hover:text-deep',
            ]}
          >
            Trivan
          </a>
        </li>
        <li class="relative">
          <details id="markus-menu" class="group">
            <summary
              class:list={[
                'list-none cursor-pointer py-2 md:py-0 transition-colors flex items-center gap-1 select-none',
                markusActive ? 'text-deep font-medium' : 'text-sea hover:text-deep',
              ]}
            >
              Markus
              <span class="text-xs opacity-70" aria-hidden="true">▾</span>
            </summary>
            <ul
              class="pl-3 md:pl-0 md:absolute md:left-0 md:top-full md:mt-2 md:min-w-[11rem] md:bg-foam md:border md:border-mist md:shadow-sm md:py-2 md:rounded-sm md:z-50"
            >
              <li>
                <a href={withBase('/markus/')} class="block md:px-4 py-2 text-sea hover:text-deep">Oversigt</a>
              </li>
              <li>
                <a href={withBase('/markus/story/')} class="block md:px-4 py-2 text-sea hover:text-deep">Indlæggelsesforløb</a>
              </li>
              <li>
                <a href={withBase('/markus/gallery/')} class="block md:px-4 py-2 text-sea hover:text-deep">Galleri</a>
              </li>
              <li>
                <a href={withBase('/markus/diplomas/')} class="block md:px-4 py-2 text-sea hover:text-deep">Diplomer</a>
              </li>
            </ul>
          </details>
        </li>
        <li>
          <a
            href={withBase('/hymns/')}
            class:list={[
              'block py-2 md:py-0 transition-colors',
              isActive('/hymns/') ? 'text-deep font-medium' : 'text-sea hover:text-deep',
            ]}
          >
            Sanghæfte
          </a>
        </li>
        <li>
          <a
            href={withBase('/about/')}
            class:list={[
              'block py-2 md:py-0 transition-colors',
              isActive('/about/') ? 'text-deep font-medium' : 'text-sea hover:text-deep',
            ]}
          >
            Om familien
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  const markusMenu = document.getElementById('markus-menu');

  toggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    nav?.classList.toggle('hidden');
    const open = !nav?.classList.contains('hidden');
    toggle.setAttribute('aria-expanded', String(open));
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;

    if (markusMenu instanceof HTMLDetailsElement && !markusMenu.contains(target)) {
      markusMenu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (markusMenu instanceof HTMLDetailsElement) {
      markusMenu.open = false;
    }
  });
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
