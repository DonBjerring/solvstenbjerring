---
interface Props {
  images: { src: string; name: string }[];
  emptyMessage: string;
  lightbox?: boolean;
}

const { images, emptyMessage, lightbox = false } = Astro.props;
---

{
  images.length === 0 ? (
    <p class="text-sea text-lg py-12">{emptyMessage}</p>
  ) : (
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 list-none p-0 m-0">
      {images.map((image, index) => (
        <li>
          <figure class="relative overflow-hidden rounded-sm bg-mist min-h-48">
            <div
              class="gallery-skeleton absolute inset-0 z-0"
              data-gallery-skeleton
              aria-hidden="true"
            />
            {lightbox ? (
              <button
                type="button"
                class="relative z-10 block w-full p-0 border-0 bg-transparent cursor-zoom-in"
                data-lightbox-trigger
                data-lightbox-index={index}
                aria-label="Vis billede større"
              >
                <img
                  src={image.src}
                  alt=""
                  class="gallery-image w-full h-auto object-cover opacity-0 transition-opacity duration-500"
                  loading="lazy"
                  data-gallery-image
                />
              </button>
            ) : (
              <img
                src={image.src}
                alt=""
                class="gallery-image relative z-10 w-full h-auto object-cover opacity-0 transition-opacity duration-500"
                loading="lazy"
                data-gallery-image
              />
            )}
          </figure>
        </li>
      ))}
    </ul>
  )
}

{
  lightbox && images.length > 0 && (
    <dialog
      id="gallery-lightbox"
      class="fixed inset-0 m-0 max-w-none max-h-none w-full h-full bg-deep/85 p-0 backdrop:bg-transparent"
      aria-label="Billedfremviser"
    >
      <button
        type="button"
        class="absolute inset-0 w-full h-full cursor-zoom-out border-0 bg-transparent"
        data-lightbox-backdrop
        aria-label="Luk"
      />

      <div class="relative z-10 flex h-full items-center justify-center px-14 md:px-20 py-16 pointer-events-none">
        <img
          id="gallery-lightbox-image"
          src={images[0].src}
          alt=""
          class="max-w-full max-h-full object-contain pointer-events-auto rounded-sm shadow-lg"
          data-lightbox-image
        />
      </div>

      <button
        type="button"
        class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 z-20 rounded-sm border border-foam/40 bg-deep/60 px-3 py-3 text-foam hover:bg-deep/80"
        data-lightbox-prev
        aria-label="Forrige billede"
      >
        ←
      </button>
      <button
        type="button"
        class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 z-20 rounded-sm border border-foam/40 bg-deep/60 px-3 py-3 text-foam hover:bg-deep/80"
        data-lightbox-next
        aria-label="Næste billede"
      >
        →
      </button>

      <p
        class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 rounded-sm bg-deep/60 px-3 py-1 text-sm text-foam"
        data-lightbox-counter
      >
        1 / {images.length}
      </p>

      <button
        type="button"
        class="absolute top-4 right-4 z-20 rounded-sm border border-foam/40 bg-deep/60 px-3 py-2 text-sm text-foam hover:bg-deep/80"
        data-lightbox-close
      >
        Luk
      </button>
    </dialog>
  )
}

{
  images.length > 0 && (
    <script define:vars={{ imageSrcs: images.map((image) => image.src), lightboxEnabled: lightbox }}>
      function revealImage(img) {
        if (!(img instanceof HTMLImageElement)) return;
        img.classList.add('is-loaded');
        const skeleton = img.closest('figure')?.querySelector('[data-gallery-skeleton]');
        if (skeleton instanceof HTMLElement) {
          skeleton.classList.add('is-hidden');
        }
      }

      document.querySelectorAll('[data-gallery-image]').forEach((img) => {
        if (!(img instanceof HTMLImageElement)) return;
        if (img.complete && img.naturalWidth > 0) {
          revealImage(img);
        } else {
          img.addEventListener('load', () => revealImage(img), { once: true });
          img.addEventListener('error', () => revealImage(img), { once: true });
        }
      });

      if (lightboxEnabled && imageSrcs.length > 0) {
        const dialog = document.getElementById('gallery-lightbox');
        const lightboxImage = document.querySelector('[data-lightbox-image]');
        const counter = document.querySelector('[data-lightbox-counter]');
        const prevBtn = document.querySelector('[data-lightbox-prev]');
        const nextBtn = document.querySelector('[data-lightbox-next]');
        const closeBtn = document.querySelector('[data-lightbox-close]');
        const backdrop = document.querySelector('[data-lightbox-backdrop]');
        const triggers = document.querySelectorAll('[data-lightbox-trigger]');

        if (dialog instanceof HTMLDialogElement && lightboxImage instanceof HTMLImageElement) {
          let currentIndex = 0;

          function show(index) {
            const total = imageSrcs.length;
            currentIndex = ((index % total) + total) % total;
            lightboxImage.src = imageSrcs[currentIndex];
            if (counter) {
              counter.textContent = `${currentIndex + 1} / ${total}`;
            }
          }

          function openAt(index) {
            show(index);
            if (!dialog.open) dialog.showModal();
          }

          function closeLightbox() {
            dialog.close();
          }

          triggers.forEach((trigger) => {
            trigger.addEventListener('click', () => {
              const index = Number(trigger.getAttribute('data-lightbox-index') ?? '0');
              openAt(index);
            });
          });

          prevBtn?.addEventListener('click', (event) => {
            event.stopPropagation();
            show(currentIndex - 1);
          });

          nextBtn?.addEventListener('click', (event) => {
            event.stopPropagation();
            show(currentIndex + 1);
          });

          closeBtn?.addEventListener('click', (event) => {
            event.stopPropagation();
            closeLightbox();
          });

          backdrop?.addEventListener('click', () => {
            closeLightbox();
          });

          dialog.addEventListener('keydown', (event) => {
            if (!dialog.open) return;
            if (event.key === 'ArrowLeft') {
              event.preventDefault();
              show(currentIndex - 1);
            } else if (event.key === 'ArrowRight') {
              event.preventDefault();
              show(currentIndex + 1);
            }
          });
        }
      }
    </script>
  )
}

<style>
  .gallery-skeleton {
    background: linear-gradient(
      90deg,
      var(--color-mist) 0%,
      var(--color-sand) 45%,
      var(--color-mist) 90%
    );
    background-size: 200% 100%;
    animation: gallery-shimmer 1.4s ease-in-out infinite;
  }

  .gallery-skeleton.is-hidden {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .gallery-image.is-loaded {
    opacity: 1;
  }

  @keyframes gallery-shimmer {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -100% 0;
    }
  }
</style>
