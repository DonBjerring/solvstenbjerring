---
import ImageWithSkeleton from './ImageWithSkeleton.astro';
import { withBase } from '../lib/urls';
import {
  formatStoryTitle,
  resolveStoryDate,
  resolveStoryImages,
  storyImageSrc,
} from '../lib/story';

interface Props {
  /** Filename in public/images/markus/story/, e.g. 20260513-160309.jpg */
  image?: string;
  /** Multiple filenames in public/images/markus/story/ */
  images?: string[];
  /** Optional body text */
  text?: string;
  /** Optional title — omitted entirely when not set */
  title?: string;
  /** Optional date override when there is no image */
  date?: Date;
}

const { image, images, text, title, date: dateOverride } = Astro.props;

const date = resolveStoryDate({ date: dateOverride, image, images });
const dateLabel = date ? formatStoryTitle(date) : null;
const imageList = resolveStoryImages({ image, images });
const imageSrcs = imageList.map((name) => withBase(storyImageSrc(name)));
const heading = title?.trim() || null;
const hasText = Boolean(text?.trim());
---

<article class="story-post">
  {
    date && dateLabel && (
      <time class="block text-sm text-sea" datetime={date.toISOString()}>
        {dateLabel}
      </time>
    )
  }

  {
    heading && (
      <h1 class:list={[date ? 'mt-2' : '', 'text-4xl text-deep']}>{heading}</h1>
    )
  }

  {
    hasText && (
      <div
        class:list={[
          heading || date ? 'mt-8' : '',
          'prose prose-lg max-w-none text-deep/90 leading-relaxed whitespace-pre-line',
        ]}
      >
        {text}
      </div>
    )
  }

  {
    imageSrcs.length > 0 && (
      <div
        class:list={[
          hasText || heading || date ? 'mt-8' : '',
          'flex flex-col gap-6',
        ]}
      >
        {imageSrcs.map((src) => (
          <ImageWithSkeleton src={src} class="rounded-sm" />
        ))}
      </div>
    )
  }
</article>
