---
interface Props {
  flush?: boolean;
}

const { flush = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['border-t border-mist', flush ? 'mt-0' : 'mt-16']}>
  <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-sea">
    <p>© {year} Familien Sølvsten Bjerring</p>
  </div>
</footer>
